
body {
    background-color: lightpink;
}

h1, h2, h3 {
    font-size: 26px;
    color:lightskyblue;
    margin-bottom: 15px;
}
p, li {
    font-size: 16px;
    color: #333333; 
    margin-bottom: 10px; 
}

ul {
    padding-left: 20px; 
    margin-bottom: 15px;
}

a {
    font-size: 16px;
    color: #3498db; 
    text-decoration: none; /* Убираем подчеркивание */
}
a:hover {
    text-decoration: underline; /* Подчеркиваем при наведении */
    color: #2980b9;
}

.content {
    display: flex;               /* Выстраивает блоки в ряд */
    justify-content: center; /* Распределяет их по краям */
    align-items: flex-start;     /* Прижимает к верху */
    width: 90%;                  /* Ширина контейнера */
    max-width: 1000px;           /* Чтобы не растягивалось на огромных экранах */
    margin: 0 auto;           /* Центрирует контейнер на странице */
    gap: 30px;                   /* Отступ между левой и правой частью */
}


.content-left {
    background-color: #ffffff;
    padding: 30px;
    border-radius: 15px;         
    width: 60%;                  /* Левая часть шире */
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1); 
    flex:1;      
}

.content-right {
    background-color: #ffffff;
    padding: 30px;
    border-radius: 15px;
    width: 40%;                  
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
    display: flex;
    flex-direction: column; 
    align-items: center; 
    text-align: center;
}
.content-right h2 {
    margin-top: 0;
    margin-bottom: 20px;
    color: lightskyblue; 
}


.profile-img {
    width: 100%;
    max-width: 300px;                 /* Картинка подстраивается под ширину блока */
    height: auto;                /* Пропорции сохраняются */
    border-radius: 10px;
    display:block;
}
